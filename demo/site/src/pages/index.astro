---
const cards = Array.from({ length: 84 }, (_, i) => i + 1);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>FeatherPerf Baseline Demo</title>
		<style>
			:root {
				--bg-a: #f9f4e9;
				--bg-b: #dce7f6;
				--ink: #1e1d1f;
				--muted: #575460;
				--card: rgba(255, 255, 255, 0.72);
			}

			* {
				box-sizing: border-box;
			}

			body {
				margin: 0;
				font-family: Georgia, "Times New Roman", serif;
				color: var(--ink);
				background:
					radial-gradient(circle at 20% 20%, rgba(255, 255, 255, 0.8), transparent 42%),
					radial-gradient(circle at 85% 20%, rgba(255, 200, 120, 0.22), transparent 38%),
					linear-gradient(155deg, var(--bg-a), var(--bg-b));
			}

			main {
				max-width: 1080px;
				padding: 28px 18px 96px;
				margin: 0 auto;
			}

			h1 {
				font-size: clamp(2rem, 5vw, 3.7rem);
				line-height: 1.05;
				margin: 0 0 12px;
			}

			p {
				margin: 0;
				color: var(--muted);
				font-size: 1.05rem;
				max-width: 62ch;
			}

			.panel {
				margin-top: 28px;
				padding: 18px;
				border: 1px solid rgba(30, 29, 31, 0.2);
				border-radius: 16px;
				background: var(--card);
				backdrop-filter: blur(3px);
			}

			.grid {
				margin-top: 32px;
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
				gap: 10px;
			}

			.orb {
				height: 96px;
				border-radius: 18px;
				border: 1px solid rgba(30, 29, 31, 0.18);
				background: linear-gradient(180deg, rgba(255, 255, 255, 0.95), rgba(229, 233, 240, 0.88));
				display: grid;
				place-items: center;
				font-size: 0.95rem;
			}

			#lottie-host {
				width: 100%;
				height: 210px;
				border-radius: 14px;
				border: 1px dashed rgba(30, 29, 31, 0.33);
				margin-top: 14px;
				display: grid;
				place-items: center;
				font-size: 1rem;
				background: rgba(255, 255, 255, 0.45);
			}

			.notice {
				margin-top: 14px;
				font-size: 0.93rem;
				color: var(--muted);
			}

			.hero {
				min-height: 132vh;
				display: grid;
				align-content: start;
				padding-top: 6vh;
			}

			.kicker {
				display: inline-flex;
				width: fit-content;
				padding: 0.4rem 0.75rem;
				border-radius: 999px;
				background: rgba(255, 255, 255, 0.72);
				border: 1px solid rgba(30, 29, 31, 0.15);
				font-size: 0.78rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--muted);
			}

			.lead {
				margin-top: 18px;
			}

			.metrics {
				margin-top: 28px;
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 12px;
			}

			.metric {
				padding: 16px;
				border-radius: 16px;
				background: rgba(255, 255, 255, 0.58);
				border: 1px solid rgba(30, 29, 31, 0.14);
			}

			.metric strong {
				display: block;
				font-size: 1.35rem;
				margin-bottom: 4px;
			}

			.metric span {
				font-size: 0.9rem;
				color: var(--muted);
			}

			.interaction-panel {
				margin-top: 22px;
				padding: 18px;
				border-radius: 18px;
				background: rgba(255, 255, 255, 0.64);
				border: 1px solid rgba(30, 29, 31, 0.14);
			}

			.interaction-copy {
				margin-top: 8px;
				margin-bottom: 14px;
				max-width: 54ch;
				font-size: 0.98rem;
			}

			.interaction-row {
				display: flex;
				flex-wrap: wrap;
				gap: 12px;
				align-items: center;
			}

			.interaction-button {
				appearance: none;
				border: 0;
				border-radius: 999px;
				padding: 0.9rem 1.2rem;
				font: inherit;
				font-size: 0.98rem;
				font-weight: 600;
				color: #fff8f0;
				background: linear-gradient(135deg, #0f4c5c, #2c6e49);
				box-shadow: 0 10px 24px rgba(15, 76, 92, 0.18);
				cursor: pointer;
			}

			.interaction-status {
				min-height: 1.4rem;
				font-size: 0.93rem;
				color: var(--muted);
			}

			.interaction-tag {
				display: inline-flex;
				width: fit-content;
				margin-top: 10px;
				padding: 0.34rem 0.68rem;
				border-radius: 999px;
				background: rgba(15, 76, 92, 0.08);
				border: 1px solid rgba(15, 76, 92, 0.14);
				font-size: 0.76rem;
				letter-spacing: 0.04em;
				text-transform: uppercase;
				color: #0f4c5c;
			}

			.deferred-shell {
				margin-top: 28vh;
				padding-top: 24px;
				border-top: 1px solid rgba(30, 29, 31, 0.12);
			}

			.shell-copy {
				margin-top: 10px;
				margin-bottom: 18px;
			}

			@media (max-width: 720px) {
				.hero {
					min-height: 154vh;
				}

				.deferred-shell {
					margin-top: 34vh;
				}

				.metrics {
					grid-template-columns: 1fr;
				}

				.grid {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}
			}
		</style>
	</head>
	<body>
		<main>
			<section class="hero">
				<div class="kicker">Critical content first</div>
				<h1>FeatherPerf Demo: Below-the-Fold Motion</h1>
				<p class="lead">
					The hero stays useful without waiting for GSAP or lottie-web. The heavy motion module
					belongs to a lower section and should only wake up when that section is close to view.
				</p>

				<div class="metrics">
					<div class="metric">
						<strong>FCP</strong>
						<span>Primary proof for this first win.</span>
					</div>
					<div class="metric">
						<strong>TBT</strong>
						<span>Needs to improve when the motion code is truly non-critical.</span>
					</div>
					<div class="metric">
						<strong>LCP</strong>
						<span>Nice to have here, but not the core claim.</span>
					</div>
				</div>

				<div class="interaction-panel">
					<strong>Interaction benchmark</strong>
					<p class="interaction-copy">
						This control stays above the fold and intentionally does very little work. The
						baseline comparison asks whether lower-page motion setup is stealing time from an
						early user input.
					</p>
					<div class="interaction-row">
						<button
							class="interaction-button"
							id="interaction-benchmark-button"
							type="button"
						>
							Tap the hero control
						</button>
						<div class="interaction-status" id="interaction-benchmark-status">
							Preparing interaction benchmark...
						</div>
					</div>
					<div class="interaction-tag">Measured by Event Timing + Lighthouse timespan</div>
				</div>
			</section>

			<section class="deferred-shell" id="deferred-showcase">
				<h2>Deferred Motion Section</h2>
				<p class="shell-copy">
					This section is intentionally below the fold. It contains the GSAP tile reveal plus the
					lottie-web initialization mount used for the benchmark.
				</p>
			</section>

			<section class="panel" id="deferred-panel">
				<strong>Animation Mount</strong>
				<div id="lottie-host">Loading lottie-web...</div>
				<div class="notice">
					Used to force lottie-web runtime initialization only when the deferred section gets close.
				</div>
			</section>

			<section class="grid" id="deferred-grid">
				{cards.map((card) => <div class="orb">Tile {card}</div>)}
			</section>
		</main>

		<script>
			(() => {
				const benchmarkButton = document.getElementById('interaction-benchmark-button');
				const benchmarkStatus = document.getElementById('interaction-benchmark-status');

				if (!(benchmarkButton instanceof HTMLButtonElement) || !(benchmarkStatus instanceof HTMLElement)) {
					return;
				}

				const benchmarkState = {
					isReady: false,
					interactionCount: 0,
					entries: [],
					lastInteraction: null,
					reset() {
						benchmarkState.interactionCount = 0;
						benchmarkState.entries = [];
						benchmarkState.lastInteraction = null;
						benchmarkStatus.textContent = 'Ready for benchmark input.';
					}
				};

				window.__featherperfInteractionBenchmark = benchmarkState;

				const round = (value) => Number.isFinite(value) ? Math.round(value) : null;

				if (typeof PerformanceObserver === 'function') {
					try {
						const observer = new PerformanceObserver((list) => {
							for (const entry of list.getEntries()) {
								if (entry.name !== 'click' && entry.name !== 'pointerdown') {
									continue;
								}

								const record = {
									name: entry.name,
									startTimeMs: round(entry.startTime),
									durationMs: round(entry.duration),
									processingDelayMs: round(entry.processingStart - entry.startTime),
									processingDurationMs: round(entry.processingEnd - entry.processingStart),
									interactionId: entry.interactionId ?? null
								};

								benchmarkState.entries.push(record);

								if (entry.name === 'click') {
									benchmarkState.lastInteraction = {
										...(benchmarkState.lastInteraction ?? {}),
										...record
									};
								}
							}
						});

						observer.observe({ type: 'event', buffered: true, durationThreshold: 16 });
					} catch {
						benchmarkStatus.textContent = 'Event Timing unavailable in this browser.';
					}
				}

				benchmarkButton.addEventListener('click', (event) => {
					benchmarkState.interactionCount += 1;
					const startedAtMs = typeof event.timeStamp === 'number' ? event.timeStamp : performance.now();
					const motionPhaseAtClick = window.__featherperfDemoMotionState?.phase ?? 'not-started';
					benchmarkButton.dataset.interactionCount = String(benchmarkState.interactionCount);
					benchmarkStatus.textContent = `Interaction ${benchmarkState.interactionCount} started...`;

					requestAnimationFrame(() => {
						requestAnimationFrame(() => {
							const manualLatencyMs = round(performance.now() - startedAtMs);
							benchmarkState.lastInteraction = {
								...(benchmarkState.lastInteraction ?? {}),
								manualLatencyMs,
								motionPhaseAtClick,
								paintSettled: true
							};
							benchmarkStatus.textContent = `Interaction ${benchmarkState.interactionCount} finished in about ${manualLatencyMs} ms.`;
						});
					});
				});

				benchmarkState.isReady = true;
				benchmarkStatus.textContent = 'Ready for benchmark input.';
			})();
		</script>

		<script>
			import { runBaselineAnimations } from '../scripts/baseline';
			runBaselineAnimations('#deferred-panel');
		</script>
	</body>
</html>
