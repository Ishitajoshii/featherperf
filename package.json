{
  "name": "featherperf-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "FeatherPerf: A performance-focused Vite plugin and runtime.",
  "scripts": {
    "build": "pnpm -r build",
    "bench:local": "pnpm --filter @featherperf/bench bench:local",
    "bench:interaction": "pnpm --filter @featherperf/bench bench:interaction",
    "bench:acmvit": "pnpm --filter @featherperf/bench bench:acmvit",
    "demo:compare": "pnpm --filter @featherperf/bench demo:compare",
    "demo:interaction": "pnpm --filter @featherperf/bench demo:interaction",
    "detect:heavy": "pnpm --filter @featherperf/vite-plugin report",
    "test": "pnpm -r test",
    "verify:pack": "node ./scripts/verify-packages.mjs",
    "dev": "pnpm -r dev"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
