{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/analyze",
        "run": {
          "serviceId": "featherperf-analyze",
          "region": "asia-south1"
        }
      }
    ]
  }
}
